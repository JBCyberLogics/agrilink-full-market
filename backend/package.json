{
  "name": "agrilink-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:local": "tsx scripts/run-local-e2e.ts",
    "test:e2e:kamis": "KAMIS_LIVE_E2E=1 tsx scripts/run-local-e2e.ts",
    "verify:provider:kamis": "tsx scripts/verify-kamis-provider.ts",
    "test:watch": "vitest",
    "db:inspect": "tsx scripts/inspect-database.ts",
    "db:init": "tsx scripts/initialize-database.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:migrate:dry-run": "tsx migrations/migrate-legacy.ts --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
