NODE_ENV=development
PORT=4300
PUBLIC_API_URL=http://localhost:4300
MONGODB_URI=mongodb://127.0.0.1:27017/agrilink?replicaSet=agrilink-rs
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/agrilink_test?replicaSet=agrilink-rs
SESSION_SECRET=
CONFIG_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5199,http://localhost:5173,http://localhost:4173
COOKIE_NAME=agrilink.sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=168
TRUST_PROXY=0
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_BYTES=5242880

# OTP flows are unavailable until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# NVIDIA credentials stay on the backend.
NVIDIA_API_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_DEFAULT_MODEL=
NVIDIA_AGRICULTURAL_ASSISTANT_MODEL=
NVIDIA_MARKET_ADVISOR_MODEL=
NVIDIA_RECOMMENDATIONS_MODEL=
NVIDIA_CROP_ADVISOR_MODEL=
NVIDIA_PRICE_ADVISOR_MODEL=
NVIDIA_LISTING_ASSISTANT_MODEL=
NVIDIA_MATCHING_ASSISTANT_MODEL=
NVIDIA_HARVEST_ADVISOR_MODEL=
NVIDIA_NET_PROFIT_ADVISOR_MODEL=
NVIDIA_PRODUCE_FINDER_MODEL=
NVIDIA_SUPPLIER_ADVISOR_MODEL=
NVIDIA_PURCHASE_ASSISTANT_MODEL=
NVIDIA_REQUEST_TIMEOUT_MS=30000
NVIDIA_MAX_RETRIES=1
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.9
NVIDIA_MAX_TOKENS=1200

# Payment providers remain unavailable until configured.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_KES_PER_USD=
PAYPAL_RATE_SOURCE=

WEATHER_API_BASE_URL=
WEATHER_API_KEY=
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_PROVIDER_KEY=
