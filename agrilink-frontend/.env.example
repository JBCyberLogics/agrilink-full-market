# Public AgriLink API configuration. Set VITE_API_BASE_URL to the actual backend origin.
# The frontend checkout has no backend or Vite API proxy. Restart Vite after changing this.
VITE_API_BASE_URL=http://localhost:4300/api/v1
VITE_AGRILINK_CONTROL_URL=http://localhost:5173
VITE_AGRILINK_AI_PROXY_URL=
VITE_AGRILINK_AI_STATUS_ENDPOINT=

# Server-only NVIDIA settings. Configure these in the backend secret store.
# Never rename these with a VITE_ prefix.
# NVIDIA provider settings and credentials belong in backend/.env only.
